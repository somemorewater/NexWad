# Core server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
WAITLIST=true
FREE_TRIAL_ENABLED=true
FREE_TRIAL_DURATION=2months

# Datastores (compose overrides these to service hostnames)
MONGODB_URI=mongodb://mongo:27017/nexwad
REDIS_URL=redis://redis:6379

# Auth
JWT_SECRET=change_me_jwt_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@nexwad.com
SMTP_PASS=your_smtp_password
EMAIL_FROM=NexWAD <noreply@nexwad.com>

# Optional tuning
OTP_EXPIRY_MINUTES=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# API key protection (comma-separated keys supported for rotation)
API_KEY_PROTECTION=true
API_KEYS=dev_key_primary,dev_key_secondary
